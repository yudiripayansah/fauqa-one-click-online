# Supabase: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server saja: render situs publik, seed, proses sistem. Jangan pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Domain induk. Admin di app.<ROOT_DOMAIN>, situs di <slug>.<ROOT_DOMAIN>.
# Development: localhost:3000 → admin di http://app.localhost:3000, situs di http://<slug>.localhost:3000
# Produksi: oneclick.fau-qa.com → admin di https://app.oneclick.fau-qa.com, situs di https://<slug>.oneclick.fau-qa.com
ROOT_DOMAIN=localhost:3000
# http di development, https di produksi
PROTOCOL=http

# Kunci HMAC token preview situs draft (PRD §8.2). Isi string acak panjang: openssl rand -hex 32
PREVIEW_SECRET=

# Email notifikasi form (Resend). Kosong = email hanya dicatat di log server (development).
RESEND_API_KEY=
EMAIL_FROM=Fauqa One Click <noreply@fau-qa.com>
# Cloudflare Turnstile (anti-spam form). Kosong = hanya honeypot + rate limit.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# AI generator konten (Claude API, PRD §4.2.1): console.anthropic.com → API Keys.
# Kosong = wizard & "Tulis dengan AI" memakai teks contoh preset industri.
ANTHROPIC_API_KEY=

# Custom domain (PRD §4.10): Vercel → Account Settings → Tokens; Project → Settings → General (Project ID).
# Kosong = domain hanya disimpan (development). Cron cek DNS harian (Hobby); di Pro bisa diubah ke tiap 15 menit di vercel.json.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Rahasia untuk /api/cron/* (Vercel mengirimnya otomatis sebagai Authorization: Bearer). openssl rand -hex 32
CRON_SECRET=
