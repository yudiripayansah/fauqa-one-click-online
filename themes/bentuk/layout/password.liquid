<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>
  {%- if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- capture fonts -%}
    family={{ settings.font_heading | replace: ' ', '+' }}:wght@500;700
    {%- if settings.font_body != settings.font_heading %}&family={{ settings.font_body | replace: ' ', '+' }}:wght@400;500{% endif -%}
  {%- endcapture %}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ fonts }}&display=swap">
  {%- style -%}
    :root {
      --color-accent: {{ settings.color_accent }};
      --color-on-accent: {{ settings.color_on_accent }};
      --color-accent-text: {{ settings.color_accent_text | default: settings.color_accent }};
      --color-ink: {{ settings.color_ink }};
      --color-bg: {{ settings.color_background }};
      --font-heading: "{{ settings.font_heading }}", ui-sans-serif, system-ui, sans-serif;
      --font-body: "{{ settings.font_body }}", ui-sans-serif, system-ui, sans-serif;
      --page-width: {{ settings.page_width }}px;
      --radius: {{ settings.radius }}px;
      --heading-weight: 700;
      --heading-tracking: -0.01em;
      --heading-case: uppercase;
      --c-red: #D7261E;
      --c-blue: #1D4FA0;
      --c-yellow: #F2B705;
    }
  {%- endstyle %}
  {{ 'sections.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <main id="main">
    {{ content_for_layout }}
  </main>
</body>
</html>
