<section class="hero hero--{{ section.settings.height }}" {{ section.fauqa_attributes }}>
  <div class="container hero__grid">
    <div class="hero__copy">
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank %}<p class="hero__text">{{ section.settings.text }}</p>{% endif -%}
      {%- if section.blocks.size > 0 -%}
        <div class="button-row">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'button' -%}
                <a href="{{ block.settings.link }}" class="button button--{{ block.settings.style }}" {{ block.fauqa_attributes }}>{{ block.settings.label }}</a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div class="hero__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 760px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'hero' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    { "type": "text", "id": "heading", "label": "Judul", "default": "Judul utama" },
    { "type": "textarea", "id": "text", "label": "Teks" },
    { "type": "image_picker", "id": "image", "label": "Gambar" },
    { "type": "text", "id": "image_alt", "label": "Teks alternatif gambar" },
    { "type": "select", "id": "height", "label": "Tinggi", "default": "large",
      "options": [{ "value": "small", "label": "Kecil" }, { "value": "large", "label": "Besar" }] }
  ],
  "blocks": [
    { "type": "button", "name": "Tombol", "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Teks", "default": "Tombol" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Gaya", "default": "primary",
          "options": [{ "value": "primary", "label": "Utama" }, { "value": "secondary", "label": "Garis" }] }
      ] }
  ],
  "max_blocks": 2,
  "presets": [{ "name": "Hero", "blocks": [{ "type": "button" }] }],
  "enabled_on": { "templates": ["index", "page"] }
}
{% endschema %}
