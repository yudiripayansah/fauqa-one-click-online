<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_title }}</title>
  {%- if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {%- capture fonts -%}
    family={{ settings.font_heading | replace: ' ', '+' }}:wght@400;500;600;700
    {%- if settings.font_body != settings.font_heading %}&family={{ settings.font_body | replace: ' ', '+' }}:wght@400;500;600{% endif -%}
  {%- endcapture %}
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ fonts }}&display=swap">
  {%- style -%}
    :root {
      --color-accent: {{ settings.color_accent }};
      --color-ink: {{ settings.color_ink }};
      --color-bg: {{ settings.color_background }};
      --font-heading: "{{ settings.font_heading }}", ui-sans-serif, system-ui, sans-serif;
      --font-body: "{{ settings.font_body }}", ui-sans-serif, system-ui, sans-serif;
      --page-width: {{ settings.page_width }}px;
      --radius: {{ settings.radius }}px;
    }
  {%- endstyle %}
  {{ 'sections.css' | asset_url | stylesheet_tag }}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="template-{{ template.name }}">
  <a class="skip-link" href="#main">{{ 'general.skip_to_content' | t }}</a>
  {% sections 'header-group' %}
  <main id="main" tabindex="-1">
    {{ content_for_layout }}
  </main>
  {% sections 'footer-group' %}
  {{ 'theme.js' | asset_url | script_tag }}
</body>
</html>
