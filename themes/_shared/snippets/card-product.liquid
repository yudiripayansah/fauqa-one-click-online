<a class="card" href="{{ product.url }}">
  <div class="card__media">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: alt: product.title, sizes: '(min-width: 760px) 30vw, 100vw' }}
    {%- else -%}
      {{ 'product' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  <h3 class="card__title">{{ product.title }}</h3>
  {%- if product.summary != blank %}<p class="card__text">{{ product.summary | truncate: 110 }}</p>{% endif -%}
  {%- if product.price != blank %}<p class="card__price">{{ product.price | money }}</p>{% endif -%}
</a>
