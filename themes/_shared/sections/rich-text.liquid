<section class="section rich-text rich-text--{{ section.settings.align }}" {{ section.fauqa_attributes }}>
  <div class="container container--narrow">
    {%- if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif -%}
    <div class="rte">{{ section.settings.text }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Teks",
  "settings": [
    { "type": "text", "id": "heading", "label": "Judul", "default": "Judul" },
    { "type": "richtext", "id": "text", "label": "Teks", "default": "<p>Tulis paragraf di sini.</p>" },
    { "type": "select", "id": "align", "label": "Perataan", "default": "left",
      "options": [{ "value": "left", "label": "Kiri" }, { "value": "center", "label": "Tengah" }] }
  ],
  "presets": [{ "name": "Teks" }]
}
{% endschema %}
