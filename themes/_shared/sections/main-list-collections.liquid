<section class="section" {{ section.fauqa_attributes }}>
  <div class="container">
    <h1>{{ 'collections.title' | t }}</h1>
    <ul class="grid">
      {%- for collection in collections -%}
        <li>
          <a class="card" href="{{ collection.url }}">
            <div class="card__media">
              {%- if collection.image -%}{{ collection.image | image_url: width: 600 | image_tag: alt: collection.title, sizes: '(min-width: 760px) 30vw, 100vw' }}{%- else -%}{{ 'collection' | placeholder_svg_tag }}{%- endif -%}
            </div>
            <h3 class="card__title">{{ collection.title }}</h3>
            <p class="card__meta">{{ 'collections.count' | t: count: collection.products_count }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    <p><a class="link" href="{{ routes.all_products_collection_url }}">{{ 'collections.all' | t }}</a></p>
  </div>
</section>

{% schema %}
{ "name": "Daftar koleksi", "settings": [], "enabled_on": { "templates": ["list-collections"] } }
{% endschema %}
