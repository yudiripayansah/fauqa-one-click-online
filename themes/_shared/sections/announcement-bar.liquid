{%- if section.settings.text != blank -%}
<div class="announcement" {{ section.fauqa_attributes }}>
  <div class="container announcement__inner">
    {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{%- else -%}<p>{{ section.settings.text }}</p>{%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{ "name": "Pengumuman", "settings": [
    { "type": "text", "id": "text", "label": "Teks", "default": "Gratis konsultasi untuk proyek baru bulan ini" },
    { "type": "url", "id": "link", "label": "Link" }
  ],
  "enabled_on": { "groups": ["header"] }, "presets": [{ "name": "Pengumuman" }] }
{% endschema %}
