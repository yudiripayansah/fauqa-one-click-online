<section class="password" {{ section.fauqa_attributes }}>
  <div class="container container--narrow password__inner">
    <p class="password__name">{{ site.name }}</p>
    <h1>{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank %}<p class="muted">{{ section.settings.text }}</p>{% endif -%}
    {%- if password_form -%}
      <form method="post" action="{{ password_form.action }}" class="password__form">
        <label class="field"><span>{{ 'password.label' | t }}</span><input type="password" name="password" autocomplete="current-password" required></label>
        {%- if password_form.error %}<p class="form-status form-status--error" role="alert">{{ 'password.wrong' | t }}</p>{% endif -%}
        <button class="button button--primary">{{ 'password.enter' | t }}</button>
      </form>
    {%- endif -%}
  </div>
</section>

{% schema %}
{ "name": "Halaman password", "settings": [
    { "type": "text", "id": "heading", "label": "Judul", "default": "Segera hadir" },
    { "type": "textarea", "id": "text", "label": "Teks", "default": "Website kami sedang disiapkan. Silakan kembali lagi nanti." }
  ],
  "enabled_on": { "templates": ["password"] } }
{% endschema %}
