{%- assign b = blogs[section.settings.blog] | default: blogs.first -%}
{%- if b -%}
<section class="section" {{ section.fauqa_attributes }}>
  <div class="container">
    <div class="section__head">
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
      <a class="link" href="{{ b.url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <ul class="grid">
      {%- for article in b.articles limit: section.settings.limit -%}<li>{% render 'card-article', article: article %}</li>{%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% schema %}
{ "name": "Artikel terbaru",
  "settings": [
    { "type": "text", "id": "heading", "label": "Judul", "default": "Berita terbaru" },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "limit", "label": "Jumlah artikel", "min": 2, "max": 6, "step": 1, "default": 3 }
  ],
  "presets": [{ "name": "Artikel terbaru" }] }
{% endschema %}
