<section class="section faq" {{ section.fauqa_attributes }}>
  <div class="container container--narrow">
    {%- if section.settings.heading != blank %}<h2 class="section__heading">{{ section.settings.heading }}</h2>{% endif -%}
    <div class="faq__list">
      {%- for block in section.blocks -%}
        <details class="faq__item" {{ block.fauqa_attributes }}{% if forloop.first and section.settings.open_first %} open{% endif %}>
          <summary>{{ block.settings.question }}</summary>
          <div class="rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{ "name": "FAQ", "settings": [
    { "type": "text", "id": "heading", "label": "Judul", "default": "Pertanyaan yang sering diajukan" },
    { "type": "checkbox", "id": "open_first", "label": "Buka pertanyaan pertama", "default": true }
  ],
  "blocks": [{ "type": "question", "name": "Pertanyaan", "settings": [
    { "type": "text", "id": "question", "label": "Pertanyaan", "default": "Berapa lama proses pengerjaan?" },
    { "type": "richtext", "id": "answer", "label": "Jawaban", "default": "<p>Tergantung skala proyek. Kami memberi jadwal tertulis setelah survei.</p>" }
  ] }],
  "max_blocks": 30,
  "presets": [{ "name": "FAQ", "blocks": [{ "type": "question" }, { "type": "question", "settings": { "question": "Apakah ada garansi?" } }, { "type": "question", "settings": { "question": "Area mana saja yang dilayani?" } }] }] }
{% endschema %}
