<section class="section timeline" {{ section.fauqa_attributes }}>
  <div class="container container--narrow">
    {%- if section.settings.heading != blank %}<h2 class="section__heading">{{ section.settings.heading }}</h2>{% endif -%}
    <ol class="timeline__list">
      {%- for block in section.blocks -%}
        <li class="timeline__item" {{ block.fauqa_attributes }}>
          <p class="timeline__year">{{ block.settings.year }}</p>
          <div><h3>{{ block.settings.title }}</h3><p class="muted">{{ block.settings.text }}</p></div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{ "name": "Timeline", "settings": [{ "type": "text", "id": "heading", "label": "Judul", "default": "Perjalanan kami" }],
  "blocks": [{ "type": "event", "name": "Peristiwa", "settings": [
    { "type": "text", "id": "year", "label": "Tahun", "default": "2010" },
    { "type": "text", "id": "title", "label": "Judul", "default": "Perusahaan berdiri" },
    { "type": "textarea", "id": "text", "label": "Keterangan" }
  ] }],
  "max_blocks": 20,
  "presets": [{ "name": "Timeline", "blocks": [{ "type": "event" }, { "type": "event", "settings": { "year": "2018", "title": "Kantor cabang pertama" } }, { "type": "event", "settings": { "year": "2026", "title": "Melayani 28 provinsi" } }] }] }
{% endschema %}
