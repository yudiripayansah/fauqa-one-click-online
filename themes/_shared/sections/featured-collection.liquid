{%- assign col = collections[section.settings.collection] | default: collections.all -%}
<section class="section featured-collection" {{ section.fauqa_attributes }}>
  <div class="container featured-collection__grid">
    <div class="featured-collection__intro">
      <h2>{{ section.settings.heading | default: col.title }}</h2>
      {%- if col.description != blank %}<div class="rte muted">{{ col.description }}</div>{% endif -%}
      <a class="button button--secondary" href="{{ col.url }}">{{ 'general.view_all' | t }}</a>
    </div>
    <ul class="grid grid--2">
      {%- for product in col.products limit: section.settings.limit -%}<li>{% render 'card-product', product: product %}</li>{%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{ "name": "Koleksi unggulan", "settings": [
    { "type": "collection", "id": "collection", "label": "Koleksi" },
    { "type": "text", "id": "heading", "label": "Judul (kosong = nama koleksi)" },
    { "type": "range", "id": "limit", "label": "Jumlah produk", "min": 2, "max": 8, "step": 2, "default": 4 }
  ],
  "presets": [{ "name": "Koleksi unggulan" }] }
{% endschema %}
