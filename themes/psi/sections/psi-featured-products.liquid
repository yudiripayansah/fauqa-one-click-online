{% assign psi_collection = collections[section.settings.collection] | default: collections.all %}

<style>
  .psi-feat__top { display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 24px; margin-bottom: 48px; }
  .psi-feat__grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; }
  .psi-feat__card { display: block; padding: 14px; text-decoration: none; color: var(--psi-text); }
  .psi-feat__img { aspect-ratio: 1 / 1; border-radius: 8px; overflow: hidden; background: #F4F1EE; }
  .psi-feat__img img { width: 100%; height: 100%; object-fit: contain; transition: transform .5s ease; }
  .psi-feat__card:hover .psi-feat__img img { transform: scale(1.04); }
  .psi-feat__body { padding: 18px 6px 8px; }
  .psi-feat__brand { font-size: 11px; letter-spacing: .2em; color: var(--psi-hi); font-weight: 500; text-transform: uppercase; }
  .psi-feat__title { font-family: var(--psi-head); font-size: 20px; line-height: 1.3; margin: 6px 0 4px; }
  .psi-feat__price { font-size: 14px; color: #A8A29E; }
  .psi-feat__price s { margin-left: 6px; opacity: .7; }
</style>

<section class="psi-s psi-g psi-g--{{ section.settings.gradient }} psi-pad">
  <div class="psi-wrap">
    <div class="psi-feat__top psi-reveal">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="psi-pill">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2 class="psi-h2">{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.button_label != blank -%}
        {%- assign all_link = psi_collection.url | default: routes.all_products_collection_url -%}
        <a href="{{ all_link }}" class="psi-btn psi-btn--outline">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>

    <div class="psi-feat__grid">
      {%- if psi_collection != blank and psi_collection.products_count > 0 -%}
        {%- for product in psi_collection.products limit: section.settings.count -%}
          <a href="{{ product.url }}" class="psi-card psi-feat__card psi-reveal" data-psi-delay="{{ forloop.index0 | times: 60 }}">
            <div class="psi-feat__img">
              {%- if product.featured_media -%}
                {{ product.featured_media | image_url: width: 800 | image_tag: alt: product.title, loading: 'lazy', sizes: '(min-width: 990px) 300px, 50vw', widths: '300, 400, 600, 800' }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'psi-feat__svg' }}
              {%- endif -%}
            </div>
            <div class="psi-feat__body">
              <h3 class="psi-feat__title">{{ product.title }}</h3>
              {%- if section.settings.show_price -%}
                <div class="psi-feat__price">
                  {{ product.price_label | escape }}
                </div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..section.settings.count) -%}
          <div class="psi-card psi-feat__card psi-reveal" data-psi-delay="{{ forloop.index0 | times: 60 }}">
            <div class="psi-feat__img psi-ph">[FOTO PRODUK]</div>
            <div class="psi-feat__body">
              <div class="psi-feat__brand">[BRAND]</div>
              <h3 class="psi-feat__title">[NAMA PRODUK]</h3>
              {%- if section.settings.show_price -%}<div class="psi-feat__price">[HARGA]</div>{%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PSI Featured Products",
  "tag": "div",
  "settings": [
    { "type": "select", "id": "gradient", "label": "Gradasi latar", "default": "diagonal", "options": [ { "value": "top", "label": "Cahaya dari atas" }, { "value": "bottom", "label": "Cahaya dari bawah" }, { "value": "left", "label": "Cahaya dari kiri" }, { "value": "right", "label": "Cahaya dari kanan" }, { "value": "center", "label": "Cahaya di tengah" }, { "value": "diagonal", "label": "Diagonal" }, { "value": "none", "label": "Polos (tanpa gradasi)" } ] },
    { "type": "text", "id": "eyebrow", "label": "Label kecil", "default": "Featured Products" },
    { "type": "inline_richtext", "id": "heading", "label": "Judul (teks miring = warna aksen)", "default": "Selected for <em>professionals</em>" },
    { "type": "collection", "id": "collection", "label": "Collection yang ditampilkan" },
    { "type": "range", "id": "count", "label": "Jumlah produk", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "show_price", "label": "Tampilkan harga", "default": false },
    { "type": "text", "id": "button_label", "label": "Teks tombol", "default": "View All Products" }
  ],
  "presets": [ { "name": "PSI Featured Products" } ]
}
{% endschema %}
